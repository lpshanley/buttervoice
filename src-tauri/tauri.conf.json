{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ButterVoice",
  "identifier": "com.lpshanley.buttervoice",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../crates"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "hud",
        "title": "ButterVoice",
        "width": 180,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false
      },
      {
        "label": "settings",
        "title": "ButterVoice Settings",
        "width": 460,
        "height": 430,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0"
    }
  }
}
